# Copy this file to .env and replace the example values on each laptop.
# Never commit .env or put real credentials in this example file.
PORT=3000

# Local MariaDB/MySQL connection (Windows, macOS and Linux).
# Create this database user and import database/schema.sql then database/seed.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=function_junction
DB_USER=junction_app
DB_PASSWORD="choose-a-local-database-password"

# Replace both values before running the app. Quote values containing # or spaces.
# Generate a session secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"
LECTURER_INVITE_CODE="choose-a-private-lecturer-invite-code"

# Optional Unix socket override. Leave unset on Windows and for normal TCP use.
# DB_SOCKET=/path/to/mariadb.sock
