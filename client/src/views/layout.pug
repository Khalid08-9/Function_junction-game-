doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= pageTitle ? pageTitle + " | Function Junction" : "Function Junction"
    link(rel="icon", href="/images/favicon.svg", type="image/svg+xml")
    link(rel="stylesheet", href="/css/style.css")
  body
    .card-ribbon(aria-hidden="true")
      each colour in ["green", "red", "blue", "yellow", "pink", "red"]
        span(class="ribbon-card ribbon-" + colour)
    header.site-header
      .header-inner
        a.brand(href="/")
          span.brand-name Function Junction
          span.brand-sub CODE &bull; CARDS &bull; TEAMWORK
        nav.header-nav
          a(href="/play") PLAY
          a(href="/how-to-play") HOW TO PLAY
          a(href="/leaderboard") LEADERBOARD
          if currentUser && currentUser.role === "lecturer"
            a(href="/lecturer") DASHBOARD
        .header-actions
          button#sound-toggle.icon-button(type="button", aria-label="Turn sound off")
            img(src="/images/icons/sound-on.svg", alt="", width="22", height="22")
          if currentUser
            .user-box
              span.user-name= currentUser.full_name
              button#logout-button.btn.btn-small.btn-logout(type="button") Log out
            if currentUser.role === "student"
              span.role-pill STUDENT
            else if currentUser.role === "lecturer"
              span.role-pill LECTURER
          else
            a.role-pill(href="/login") Log In
    main.page
      block content
    script(src="/js/common.js")
    block scripts
