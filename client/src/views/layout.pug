doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= pageTitle ? pageTitle + " | Function Junction" : "Function Junction"
    link(rel="icon", href="/images/favicon.svg", type="image/svg+xml")
    link(rel="stylesheet", href="/css/style.css")
  body
    .card-ribbon(aria-hidden="true")
      each colour in ["green", "red", "blue", "yellow", "pink", "red"]
        span(class="ribbon-card ribbon-" + colour)
    header.site-header
      .header-inner
        a.brand(href="/")
          span.brand-name Function Junction
          span.brand-sub CODE &bull; CARDS &bull; TEAMWORK
        nav.header-nav
          a(href="/play") PLAY
          a(href="#") HOW TO PLAY
          a(href="#") LEADERBOARD
        .header-actions
          button#sound-toggle.icon-button(type="button", aria-label="Turn sound off")
            img(src="/images/icons/sound-on.svg", alt="", width="24", height="24")
          if currentUser
            .user-box
              span.user-name= currentUser.full_name
              button#logout-button.btn.btn-small.btn-pink(type="button") Log out
            if currentUser.role === "student"
              a.btn.btn-pink.btn-small(href="/play") STUDENT
    main.page
      block content
    script(src="/js/common.js")
    block scripts
