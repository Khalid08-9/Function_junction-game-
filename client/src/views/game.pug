extends layout

block content
  section#game-room(
    data-session-id=session.session_id,
    data-my-team-id=(myTeam ? myTeam.team_id : ''),
    data-my-user-id=currentUser.user_id,
    data-question-seconds=questionSeconds
  )
    .scorebar
      each team in teams
        .score-team(data-team-id=team.team_id, data-colour=team.team_colour.toLowerCase(), class=(myTeam && team.team_id === myTeam.team_id ? 'mine' : null))
          span.score-name= team.team_name
          span.score-value(data-score)= team.current_score
    p#round-info.round-info(aria-live='polite')
    #turn-banner.turn-banner(role='status', aria-live='polite') Loading the game...
    p#game-message.message(role='alert', hidden)

    //- Jackaroo Live Board
    .board-wrapper
      #jackaroo-board.board
        //- Center card placement (like the real physical Jackaroo board)
        #board-center.board-center
          #center-card-slot.center-card-slot
            img#center-card-img.center-card-img(src="/images/cards/card-back.svg", alt="Board Center", hidden)
            span#center-brand.center-brand Function<br>Junction

    //- 1. Card selection bar
    section#panel-cards.game-panel
      h2.panel-title Pick a card to play
      .cards-row#card-buttons
        each card in cards
          button.card-pick-btn(type='button', data-card-id=card.card_id, data-card-name=card.card_name, disabled)
            img(src=card.image, alt=card.card_name, width='80', height='112')
            span.card-pick-name= card.card_name
            span.card-pick-effect= card.card_effect
      .button-row
        button#end-turn-button.btn.btn-small.btn-pink(type='button', hidden) End my turn
      p#turn-hint.hint(aria-live='polite')

    //- 2. QR Code Display: Scan to phone to answer!
    section#panel-card-qr.game-panel(hidden)
      .qr-panel-inner
        .qr-card-info
          h2.panel-title Card Played
          img#qr-card-img.qr-card-img(src="/images/cards/card-back.svg", alt="Card", width="100", height="140")
          h3#qr-card-name.qr-card-name Card Name
          p#qr-card-effect.hint Card Effect
        .qr-scan-box
          h3.subtitle 📱 Scan with your phone to answer!
          .qr-image-wrapper
            img#qr-code-img.qr-code-img(src="", alt="QR Code to scan with phone")
          p#qr-status-text.qr-status
            span.qr-pulse-dot
            |  Waiting for answer from phone camera...
          .button-row
            button#btn-answer-desktop.btn(type="button") 💻 Or answer on this screen
            button#btn-cancel-qr.btn.btn-small.btn-pink(type="button") Cancel / Pick another card

    //- 3. Move choice (for Ace / King / 10 branching actions)
    section#panel-move-choice.game-panel(hidden)
      h2.panel-title Choose your move
      p#move-action-text.subtitle
      .move-choices#move-choices
      button#cancel-move-choice.btn.btn-small.btn-pink(type='button') Cancel

    //- 4. Marble selection prompt (highlighted on board)
    section#panel-select-marble.game-panel(hidden)
      h2#select-marble-title.panel-title Select a marble
      p#select-marble-hint.hint Click one of your highlighted glowing marbles on the board
      button#cancel-select.btn.btn-small.btn-pink(type='button') Cancel

    //- 5. Question on screen (if answered directly on screen)
    section#panel-question.game-panel(hidden)
      p#card-detected.label
      .question-head
        h2#question-title.question-title
        #timer.timer
          img(src='/images/icons/timer.svg', alt='', width='22', height='22')
          span#timer-text 00:00
      pre#question-code.code-block(hidden)
      form#answer-form(novalidate)
        #options.options
        button#submit-answer.btn(type='submit', disabled) Submit answer

    //- 6. Result
    section#panel-result.game-panel.result(hidden)
      img#result-icon.result-icon(src='/images/icons/correct.svg', alt='', width='72', height='72')
      h2#result-title.title
      p#result-action.result-action
      p#result-points.result-points
      p#result-score.hint
      p#result-answer.result-answer(hidden)
      p#result-explanation.hint(hidden)
      .button-row
        button#move-marble-btn.btn(type='button') Move your marble
        button#skip-move-btn.btn.btn-small.btn-pink(type='button') Skip move

    //- 7. Game over
    section#panel-finished.game-panel(hidden)
      h2.title Game finished!
      p#final-line.subtitle
      a.btn(href='/play') Back to home

    //- Turn order
    section.game-panel
      h3.panel-title Turn order this round
      ol#order-list.order-list

block scripts
  script(src='/js/game.js')
