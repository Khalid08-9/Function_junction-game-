extends layout

block content
  section#game-room(
    data-session-id=session.session_id,
    data-my-team-id=myTeam.team_id,
    data-my-user-id=currentUser.user_id,
    data-question-seconds=questionSeconds
  )
    .scorebar
      each team in teams
        .score-team(data-team-id=team.team_id, data-colour=team.team_colour.toLowerCase(), class=(team.team_id === myTeam.team_id ? "mine" : null))
          span.score-name= team.team_name
          span.score-value(data-score)= team.current_score
    p#round-info.round-info(aria-live="polite")
    #turn-banner.turn-banner(role="status", aria-live="polite") Loading the game...
    p#game-message.message(role="alert", hidden)

    //- 1. Ready: the strong cards, scan and end turn
    section#panel-idle.card
      h2.title Your strong cards
      .cards-row
        each card in cards
          figure.strong-card
            img.card-img(src=card.image, alt=card.card_name + " card", width="120", height="168")
            figcaption
              strong= card.card_name
              span= card.card_effect
      .button-row
        button#scan-button.btn(type="button", disabled) Scan a card
        button#end-turn-button.btn.btn-pink(type="button", hidden) End my turn
      p#turn-hint.hint(aria-live="polite")
      h3.subtitle Turn order this round
      ol#order-list.order-list

    //- 2. Scan a card (camera or typed code)
    section#panel-scan.card(hidden)
      h2.title Scan your strong card
      p.subtitle Hold the QR code inside the frame.
      .scanner
        video#scan-video(playsinline, muted)
        img.scanner-frame(src="/images/qr-frame.svg", alt="")
      p#scan-status.hint(aria-live="polite")
      p#scan-error.message(role="alert", hidden)
      form#card-form(novalidate)
        .field
          label(for="card-code") Or type the card code
          input#card-code(type="text", maxlength="100", autocomplete="off")
        button.btn(type="submit") Use this code
      button#scan-cancel.btn.btn-small.btn-pink(type="button") Cancel
      canvas#scan-canvas(hidden)

    //- 3. The Python question with the timer
    section#panel-question.card(hidden)
      p#card-detected.label
      .question-head
        h2#question-title.question-title
        #timer.timer
          img(src="/images/icons/timer.svg", alt="", width="22", height="22")
          span#timer-text 00:00
      pre#question-code.code-block(hidden)
      form#answer-form(novalidate)
        #options.options
        button#submit-answer.btn(type="submit", disabled) Submit answer

    //- 4. The result
    section#panel-result.card.result(hidden)
      img#result-icon.result-icon(src="/images/icons/correct.svg", alt="", width="72", height="72")
      h2#result-title.title
      p#result-action.result-action
      p#result-points.result-points
      p#result-score.hint
      p#result-answer.result-answer(hidden)
      p#result-explanation.hint(hidden)
      button#continue-button.btn(type="button") Continue game

    //- 5. The game is over
    section#panel-finished.card(hidden)
      h2.title Game finished
      p#final-line.subtitle
      a.btn(href="/play") Back to home

block scripts
  script(src="/js/vendor/jsQR.js")
  script(src="/js/game.js")
